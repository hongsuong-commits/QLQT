# Server
PORT=3000

# AI explanation provider (OpenAI-compatible API)
# Keep this file server-side. Never expose the key through Vite/client variables.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=90000

# Optional storage overrides. On a hosted backend point these at a persistent disk.
# DATA_DIR=./data
# DB_PATH=./data/app.db
# MAX_UPLOAD_BYTES=15728640

# Shared secret between the Express host and the Vercel /api proxy.
# Set the same value as ORIGIN_SECRET in Vercel; leave empty to disable the check.
# ORIGIN_SECRET=
